# Serves the web UI and the docs, and proxies the API on the same origin, so the session
# cookie and the API's origin check need no CORS. Set from the environment (D427), as the
# image is the same for everyone:
#   POLYTHOUGHT_DOMAIN, the site: a domain, such as polythought.example.com, for which Caddy
#     gets and renews a certificate itself, on ports 80 and 443; unset, plain HTTP on :80, for
#     TLS in front.
#   POLYTHOUGHT_WEB_TRUSTED_PROXIES, address ranges separated by spaces, such as a tunnel's:
#     proxies in front whose X-Forwarded-For is kept; none unless set, so a client's address
#     is where the connection comes from.
{
	admin off
	servers {
		trusted_proxies static {$POLYTHOUGHT_WEB_TRUSTED_PROXIES}
	}
}

# The API, told the client's address alone, as Caddy finds it from the proxies it trusts:
# with a proxy's appended after it, the API would take the proxy's.
(api) {
	reverse_proxy {$API_UPSTREAM:api:8080} {
		header_up X-Forwarded-For {client_ip}
	}
}

{$POLYTHOUGHT_DOMAIN::80} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# Scripts only from this origin. Styles may be inline: the canvas, dialogs and
		# toasts position themselves with style attributes.
		Content-Security-Policy "default-src 'self'; script-src 'self'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}

	handle /api/* {
		import api
	}

	# Agents' endpoint, and the OAuth metadata they look for at the root (RFC 8414, RFC 9728).
	handle /mcp {
		import api
	}

	handle /.well-known/oauth-* {
		import api
	}

	# The docs, a static site. Its Content-Security-Policy replaces the app's: it allows the
	# docs' few inline scripts by hash and WebAssembly for search (docs/scripts/csp.mjs
	# writes it at build time).
	handle /docs* {
		import /etc/caddy/docs-csp.caddy
		root * /srv

		@hashed path /docs/_astro/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		@page not path /docs/_astro/*
		header @page Cache-Control no-cache

		file_server
	}

	handle {
		root * /srv

		# File names under /assets carry a content hash, so they never change.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		# Every other path is a page of the app: serve index.html and let the router
		# handle it, uncached so a deploy is picked up at once.
		@page not path /assets/*
		header @page Cache-Control no-cache

		try_files {path} /index.html
		file_server
	}

	# A page missing from the docs gets the docs' own not-found page, with a 404.
	handle_errors 404 {
		@docs path /docs*
		handle @docs {
			import /etc/caddy/docs-csp.caddy
			root * /srv
			rewrite * /docs/404.html
			file_server
		}
	}
}
