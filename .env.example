# Settings for running Polythought locally. Copy this file to .env and fill it in:
#   docker compose -f deployments/docker-compose.yml --env-file .env --profile app up -d
#                              the released images, at http://localhost:3000
#   make up                    the same, built from this checkout
#   make run + make web-dev    the API and the UI for development, at http://localhost:5173
# Values are single-quoted so the shell and Docker Compose read them alike. The same values
# can live in configs/polythought.yml instead (see configs/polythought.example.yml); these
# win over it.

# Encrypts stored wallet API credentials. Make one with:
#   echo "k1:$(openssl rand -base64 32)"
# Keep it: with another key, saved credentials can no longer be read.
POLYTHOUGHT_SECRET_KEYS=''

# The first admin, created on start when there is no admin yet. At least 12 characters.
POLYTHOUGHT_ADMIN_EMAIL=''
POLYTHOUGHT_ADMIN_PASSWORD=''

# The released version the compose file pulls, such as 1.2.3 or 1.2; latest unless set.
# make up builds this checkout instead. The updater sets it as it updates.
# POLYTHOUGHT_VERSION='latest'

# The updater's token, which the API sends it: with --profile updater, an admin updates
# from the Config page. Make one with: openssl rand -hex 32
# POLYTHOUGHT_UPDATER_TOKEN=''

# Everything below the line is optional. An admin can change these on the Config page
# (Admin, then Config) while the server runs; one set here wins and is locked there.
# ---

# Who may create accounts: open, invite (needs a code from an admin) or closed.
# POLYTHOUGHT_REGISTRATION='invite'

# Webhook nodes reach only the public internet. Set to true to let them post to your
# own network too, e.g. a chat server on the same machine.
# POLYTHOUGHT_WEBHOOK_ALLOW_PRIVATE='false'

# debug, info, warn or error; text or json.
# POLYTHOUGHT_LOG_LEVEL='info'
# POLYTHOUGHT_LOG_FORMAT='text'

# The database and the address browsers use are set by each way of running. Set these only
# to point `make run` elsewhere; `make up` ignores them.
# POLYTHOUGHT_DATABASE_URL='postgres://polythought:polythought@localhost:5432/polythought?sslmode=disable'
# POLYTHOUGHT_PUBLIC_URL='http://localhost:5173'
