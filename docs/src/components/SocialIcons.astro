---
// Starlight's header slot for social links: the repository's link, with its stars while
// the server knows them (D372, D389), as the app's top bar shows it. The docs are static,
// so a script asks the server's /api/v1/meta on the same origin; without an answer, as
// under `astro dev`, the link shows no count.
const repo = 'https://github.com/lein3000zzz/polythought-go'
---

<a href={repo} target="_blank" rel="noopener noreferrer" class="github" data-github>
  <svg viewBox="0 0 16 16" aria-hidden="true" fill="currentColor">
    <path
      d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"
    ></path>
  </svg>
  GitHub
  <span class="stars" hidden>
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path
        d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"
      ></path>
    </svg>
    <span data-count></span>
  </span>
</a>

<script>
  // As the app's formatCount (web/src/lib/format.ts): 999, 1.2k, 12k, 1.2m.
  function formatCount(n: number): string {
    if (n < 1000) return n.toString()

    const [size, unit] = n < 1_000_000 ? [1000, 'k'] : [1_000_000, 'm']
    const tenths = Math.floor(n / (size / 10))
    const text = tenths < 100 ? (tenths / 10).toString() : Math.floor(tenths / 10).toString()

    return text + unit
  }

  async function showStars() {
    const res = await fetch('/api/v1/meta', { headers: { Accept: 'application/json' } })
    if (!res.ok) return

    const { stars } = (await res.json()) as { stars?: unknown }
    if (typeof stars !== 'number') return

    const exact = stars.toLocaleString('en')

    // The header has the link, and so has the menu on narrow screens.
    for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-github]')) {
      // Named in full, as the app's link: the count reads "1.2k" otherwise.
      link.ariaLabel = `GitHub, ${exact} stars`
      link.title = `${exact} stars on GitHub`
      link.querySelector('[data-count]')!.textContent = formatCount(stars)
      link.querySelector<HTMLElement>('.stars')!.hidden = false
    }
  }

  // No server beside the docs, or it did not answer: no count.
  showStars().catch(() => {})
</script>

<style>
  .github {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    text-decoration: none;
  }
  .github:hover {
    color: var(--sl-color-white);
  }
  .github > svg {
    width: 1rem;
    height: 1rem;
  }
  .stars:not([hidden]) {
    display: flex;
    align-items: center;
    gap: 0.125rem;
    font-variant-numeric: tabular-nums;
  }
  .stars svg {
    width: 0.875rem;
    height: 0.875rem;
  }
</style>
