# Serves the web UI and the docs, and proxies the API on the same origin, so the session
# cookie and the API's origin check need no CORS. Put TLS in front, or give Caddy a domain and let it
# manage certificates itself.
{
	admin off
}

:80 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# Scripts only from this origin. Styles may be inline: the canvas, dialogs and
		# toasts position themselves with style attributes.
		Content-Security-Policy "default-src 'self'; script-src 'self'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}

	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:8080}
	}

	# Agents' endpoint, and the OAuth metadata they look for at the root (RFC 8414, RFC 9728).
	handle /mcp {
		reverse_proxy {$API_UPSTREAM:api:8080}
	}

	handle /.well-known/oauth-* {
		reverse_proxy {$API_UPSTREAM:api:8080}
	}

	# The docs, a static site. Its Content-Security-Policy replaces the app's: it allows the
	# docs' few inline scripts by hash and WebAssembly for search (docs/scripts/csp.mjs
	# writes it at build time).
	handle /docs* {
		import /etc/caddy/docs-csp.caddy
		root * /srv

		@hashed path /docs/_astro/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		@page not path /docs/_astro/*
		header @page Cache-Control no-cache

		file_server
	}

	handle {
		root * /srv

		# File names under /assets carry a content hash, so they never change.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		# Every other path is a page of the app: serve index.html and let the router
		# handle it, uncached so a deploy is picked up at once.
		@page not path /assets/*
		header @page Cache-Control no-cache

		try_files {path} /index.html
		file_server
	}

	# A page missing from the docs gets the docs' own not-found page, with a 404.
	handle_errors 404 {
		@docs path /docs*
		handle @docs {
			import /etc/caddy/docs-csp.caddy
			root * /srv
			rewrite * /docs/404.html
			file_server
		}
	}
}
